+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define MEOWPAD_VOLUME_VISIBLE_MS 2000
+
+typedef struct {
+    uint32_t changed_at;
+    uint8_t percent;
+    bool muted;
+    bool received;
+    bool active;
+} meowpad_volume_state_t;
+
+static inline bool meowpad_volume_receive(meowpad_volume_state_t *state, const uint8_t *data, uint8_t length, uint32_t now) {
+    if (length != 32 || data[0] != 0xAB || data[1] != 'M' || data[2] != 'P' || data[3] != 1 || data[4] > 100 || data[5] > 1) {
+        return false;
+    }
+    bool muted = data[5] != 0;
+    if (!state->received || state->percent != data[4] || state->muted != muted) {
+        state->percent = data[4];
+        state->muted = muted;
+        state->changed_at = now;
+        state->received = true;
+        state->active = true;
+    }
+    return true;
+}
+
+static inline bool meowpad_volume_visible(meowpad_volume_state_t *state, uint32_t now) {
+    if (state->active && (uint32_t)(now - state->changed_at) >= MEOWPAD_VOLUME_VISIBLE_MS) {
+        state->active = false;
+    }
+    return state->active;
+}
