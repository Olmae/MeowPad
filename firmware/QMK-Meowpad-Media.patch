+        uint32_t animation_step = (uint32_t)(now - layer_changed_at) / MEOWPAD_ANIMATION_DELAY_MS;
+        frame = 9 + (animation_step < 3 ? animation_step : 2);
+    }
+    if (overlay_drawn || frame != last_frame) {
+        draw_page(layer, frame);
+        overlay_drawn = false;
+        last_frame = frame;
+    }
+    return false;
+}
