+        if (!music_drawn || last_media_frame != host_seen_at) {
+            draw_music();
+            music_drawn = true;
+            overlay_drawn = false;
+            last_media_frame = host_seen_at;
+        }
+        return false;
+    }
+    if (music_drawn) {
+        music_drawn = false;
+        last_frame = UINT8_MAX;
+    }
