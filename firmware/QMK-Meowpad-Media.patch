+static uint8_t app_level;
+static uint8_t app_mode;
+
+static bool media_host_active(uint32_t now) {
+    return host_seen && (uint32_t)(now - host_seen_at) < 5000;
+}
+
+static void copy_oled_text(char *text, const uint8_t *data) {
+    uint8_t i = 0;
+    for (; i < 25 && data[i] >= 32 && data[i] <= 126; ++i) {
+        text[i] = data[i];
+    }
+    text[i] = '\0';
+}
+
+static bool receive_media(const uint8_t *data, uint8_t length, uint32_t now) {
+    if (length != 32 || data[0] != 0xAB || data[1] != 'M' || data[2] != 'P' || data[3] != 2) {
+        return false;
+    }
+    if (data[4] == 'T' && data[5] <= 1 && data[6] <= 100) {
+        copy_oled_text(track_title, &data[7]);
+        track_playing = data[5] != 0;
+        track_progress = data[6];
+        host_seen = true;
+        host_seen_at = now;
+        return true;
+    }
+    if (data[4] == 'V' && (data[5] == 'S' || data[5] == 'A') && (data[6] <= 100 || data[6] == 255)) {
+        copy_oled_text(app_name, &data[7]);
+        app_mode = data[5];
+        app_level = data[6];
+        app_changed_at = now;
+        app_active = true;
+        return true;
+    }
+    return false;
+}
+
+bool pre_process_record_user(uint16_t keycode, keyrecord_t *record) {
+    static bool encoder_captured;
+    uint8_t layer = get_highest_layer(layer_state | default_layer_state);
+    bool encoder = IS_ENCODEREVENT(record->event);
+    if (encoder && !record->event.pressed && encoder_captured) {
+        encoder_captured = false;
+        return false;
+    }
+    if (!media_host_active(timer_read32())) {
+        return true;
+    }
+    if (encoder && record->event.pressed && (layer == 1 || layer == 6)) {
+        bool clockwise = record->event.type == ENCODER_CW_EVENT;
+        uint16_t shortcut = layer == 1 ? (clockwise ? KC_F14 : KC_F13) : (clockwise ? KC_F16 : KC_F15);
+        tap_code16(C(A(shortcut)));
+        encoder_captured = true;
+        return false;
+    }
+    if (layer == 1 && !encoder) {
+        switch (keycode) {
+            case KC_LEFT:
+            case KC_DOWN:
+            case KC_RIGHT:
+                if (record->event.pressed) {
+                    tap_code(keycode == KC_LEFT ? KC_MPRV : keycode == KC_RIGHT ? KC_MNXT : KC_MPLY);
+                }
+                return false;
+        }
+    }
+    return true;
+}
+
+void raw_hid_receive_kb(uint8_t *data, uint8_t length) {
+    uint32_t now = timer_read32();
+    if (!meowpad_volume_receive(&volume, data, length, now) && !receive_media(data, length, now)) {
+        data[0] = id_unhandled;
+    }
+}
 
